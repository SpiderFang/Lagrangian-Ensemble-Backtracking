  "color_scale_policy": {
    "adopted_from": "OCM-SVD-Analysis fixed vmin/vmax + over-limit saturation (no data clipping)",
    "color_scale_dataclass": "figures.ColorScale",
    "vmin_fixed": 0.0,
    "vmin_rationale_zh": "KDE 密度與相對來源權重皆為非負量",
    "tick_count_default": 7,
    "vmax_basis": "max_of_finite_values_across_selected_sites_this_run",
    "vmax_basis_diverges_from_ocm_zh": "OCM-SVD-Analysis 之 vmax=0.024 為經審查之歷史常數；LBT 尚未建立此類跨 run 常數，見 rules_document 第 5 節誠實揭露。",
    "colorbar_extend": "neither",
    "data_clipping": false,
    "display_saturation_mechanism": "matplotlib Normalize(vmin, vmax) 內建飽和語意，不額外裁切資料",
    "over_limit_metadata_fields": [
      "over_limit_count",
      "over_limit_fraction",
      "display_saturation"
    ],
    "over_limit_denominator": "finite_value_count_only",
    "hard_limit_stop_and_resubmit": null,
    "hard_limit_rationale_zh": "OCM-SVD-Analysis 之 1% 硬性上限機制以審查過的固定 vmax 為前提；LBT 目前 vmax 取自本次執行實際最大值，數學上不會產生超限，套用相同硬性門檻無實質意義，見 rules_document 第 4 節。"
  },

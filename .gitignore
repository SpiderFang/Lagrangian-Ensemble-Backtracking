# Python 與測試工具產生的本機快取不得進入版本控制。
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# 虛擬環境與套件管理器快取會依主機重建，不屬於研究成果。
.venv/
.uv-cache/

# 大型 forcing、軌跡、checkpoint 與聚合成果體積龐大且可能含 SERVER 路徑；
# repository 只保存 schema、小型合成 fixture、程式與不可變 manifest 範例。
BayTrace/
data/
work/
outputs/
checkpoints/
docs/output/
tmp/
logs/*.log
logs/*.jsonl
*.parquet
*.npy
*.npz

# SERVER 專案根的執行資料可能含大型結果、執行狀態與舊版快照；它們不是程式來源，
# 應以資料清單／校驗碼另行管理。規則只錨定專案根，避免誤忽略程式來源內偶然同名的
# 目錄，也不把忽略規則誤稱為 Git 全量同步。
/server_outputs/
/server_runs/
/versions/

# 海廢分類與情境設計的文字索引屬可稽核研究契約，應隨程式版本保存；大型原文、
# 標註 PDF 與品質檢查影像仍由上方 data 規則忽略，避免把文獻全文誤當輕量原始碼。
!data/
data/*
!data/marine_litter_classification/
data/marine_litter_classification/*
!data/marine_litter_classification/README.md
!data/scenario_design_literature/
data/scenario_design_literature/*
!data/scenario_design_literature/README.md
# 成果呈現文獻的原始 PDF、紅框副本與暫存影像體積大且受各出版商授權限制；
# 只追蹤可稽核的繁中索引 README，避免把全文或 QA PNG 誤提交至 Git。
!data/results_visualization_literature/
data/results_visualization_literature/*
!data/results_visualization_literature/README.md
# 時間缺口重建文獻索引同樣是小型、可稽核的文字契約；只追蹤 README，原文與標註
# PDF 仍維持忽略，避免把授權受限或大型附件帶入程式版本。
!data/time_reconstruction_literature/
data/time_reconstruction_literature/*
!data/time_reconstruction_literature/README.md

# 作業系統與編輯器暫存檔。
.DS_Store
*.swp
*.tmp

{
  "schema_version": "3.0.0",
  "grid_spacing_m": 1000,
  "output_root": "preprocessed",
  "products": [
    "ocm_native",
    "ocm_surface"
  ],
  "native_required_variables": [
    "hvel",
    "vertical_velocity",
    "zcor",
    "elev",
